{
  "schemaVersion": 1,
  "id": "jh4j3-openapi3",
  "status": "excluded-in-robot",
  "codegenEnabled": false,
  "java": 8,
  "springBootMajor": 2,
  "jh4jCloud": "3.1.0",
  "serviceStyle": "direct",
  "apiDocumentation": "openapi3",
  "validationNamespace": "javax.validation",
  "apiDefaults": {
    "page": { "method": "POST", "path": "queryPage" },
    "detail": { "method": "GET", "path": "getById/{id}" },
    "create": { "method": "POST", "path": "save" },
    "update": { "method": "PUT", "path": "updateById" },
    "remove": { "method": "DELETE", "path": "deleteById/{id}" },
    "export": { "method": "GET", "path": "export" }
  },
  "response": {
    "successCode": 2000,
    "envelope": ["code", "message", "data"],
    "pageRecordsPath": "data.records",
    "pageTotalPath": "data.total"
  },
  "tenant": {
    "mode": "explicit",
    "column": "COMPANY_ID",
    "javaField": "companyId",
    "provider": "AuthUtil.getLoginCompanyId()",
    "requestSupplied": false
  },
  "softDelete": {
    "column": "DELETE_FLAG",
    "javaField": "deleteFlag",
    "activeValue": 1,
    "deletedValue": 0,
    "mysqlType": "TINYINT(1)",
    "oracleType": "NUMBER(1)"
  },
  "auditTime": {
    "mysqlType": "VARCHAR(19)",
    "oracleType": "VARCHAR2(19 CHAR)"
  },
  "idPolicy": {
    "javaType": "String",
    "maxLength": 64,
    "oracleType": "VARCHAR2(64 CHAR)",
    "mysqlType": "VARCHAR(64)",
    "format": "opaque"
  },
  "auditColumns": {
    "actorMaxLength": 64,
    "createUserNullable": false,
    "updateUserNullable": true,
    "createTimeNullable": false,
    "updateTimeNullable": true
  },
  "optimisticLock": {
    "column": "REVISION",
    "javaField": "revision",
    "initialValue": 0
  }
}
