{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-team.example/schemas/wl-quality-gate-v1.json",
  "title": "wl-skills-bd change review quality gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baselineMode": { "enum": ["new-only", "all"] },
    "baselineFile": { "type": "string", "minLength": 1 },
    "blockSeverities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["error", "warn", "info"] }
    },
    "requireCompleteRuleCoverage": { "type": "boolean" },
    "warningBudget": { "type": ["integer", "null"], "minimum": 0 },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "reportPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "minimumLine": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "minimumChangedLine": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "exemptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "owner", "reason", "approvalRef", "expiresAt"],
        "properties": {
          "fingerprint": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 5 },
          "approvalRef": { "type": "string", "minLength": 1 },
          "expiresAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
