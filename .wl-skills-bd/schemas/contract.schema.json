{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-team.example/schemas/wl-backend-contract-v1.json",
  "title": "wl-skills-bd backend resource contract",
    "description": "生产安全契约：团队 Java 8/Spring Boot 2 基线、显式字段写策略、数据分级、状态初值、强类型业务命令、原子版本写、Expand/Contract DDL 和 Flyway 不可变门。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "profile", "rootPackage", "module", "entity", "api", "database", "migration", "fields"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractKind": { "const": "crud", "description": "严格代码生成契约固定为 crud；schema-mirror/integration-projection 由兼容检查器只读治理，不进入 codegen" },
    "contractId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
    "profile": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9-]+$" },
    "rootPackage": { "type": "string", "maxLength": 200, "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-z][a-zA-Z0-9]*)+$" },
    "module": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-zA-Z0-9]*$" },
    "externalId": { "$ref": "#/$defs/stableId", "description": "可选，对应 wl-skills-design 的 design-model.json entity.id，用于跨包稳定 ID 追溯" },
    "environment": { "enum": ["dev", "sit", "uat", "pre", "prod"], "description": "可选，声明契约适用的环境；不声明则环境无关。声明 prod 时 codegen apply 默认阻断（详见 standards/24 §6）" },
    "dbCluster": { "enum": ["cx", "non_cx", "pt"], "description": "可选，数据库集群归属：cx=产销库 / non_cx=非产销库 / pt=平台库；doctor 校验与 datasource profile 一致（standards/24 §3.3）" },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "description": "可选，只记录契约生成来源，不改变业务语义；路径必须为安全的项目相对路径。",
      "properties": {
        "source": { "type": "string", "minLength": 1, "maxLength": 300 },
        "schemaSnapshot": { "type": "string", "minLength": 1, "maxLength": 300 },
        "phase": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "description": "可选生产保障契约。level=production 时，completion 还必须取得安全/SLA/容灾/数据治理证据文件。",
      "properties": {
        "level": { "enum": ["standard", "production"] },
        "criticality": { "enum": ["core", "important", "standard"] },
        "slo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["availabilityPercent", "p95LatencyMs", "p99LatencyMs", "maxErrorRatePercent"],
          "properties": {
            "availabilityPercent": { "type": "number", "minimum": 90, "maximum": 100 },
            "p95LatencyMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
            "p99LatencyMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
            "maxErrorRatePercent": { "type": "number", "minimum": 0, "maximum": 10 }
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rtoMinutes", "rpoMinutes"],
          "properties": {
            "rtoMinutes": { "type": "integer", "minimum": 0, "maximum": 525600 },
            "rpoMinutes": { "type": "integer", "minimum": 0, "maximum": 525600 }
          }
        },
        "security": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorizationModel", "methodSecurityRequired", "auditRequired"],
          "properties": {
            "authorizationModel": { "enum": ["tenant", "tenant-data-scope", "custom"] },
            "methodSecurityRequired": { "const": true },
            "auditRequired": { "const": true }
          }
        },
        "dataGovernance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "sourceOfTruth", "classificationDefault", "retentionPolicy"],
          "properties": {
            "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
            "sourceOfTruth": { "type": "string", "minLength": 1, "maxLength": 100 },
            "classificationDefault": { "enum": ["public", "internal", "confidential", "restricted"] },
            "retentionPolicy": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "consistency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["idempotencyStrategy", "eventDelivery", "crossServiceTransaction"],
          "properties": {
            "idempotencyStrategy": { "enum": ["request-key", "business-key", "state-machine"] },
            "eventDelivery": { "enum": ["none", "outbox", "transactional-message"] },
            "crossServiceTransaction": { "enum": ["none", "saga", "seata"] }
          }
        },
        "resilience": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dependencyTimeoutMs", "retryMaxAttempts", "circuitBreakerRequired", "rateLimitRequired"],
          "properties": {
            "dependencyTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 300000 },
            "retryMaxAttempts": { "type": "integer", "minimum": 0, "maximum": 3 },
            "circuitBreakerRequired": { "type": "boolean" },
            "rateLimitRequired": { "type": "boolean" }
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["threatModelRef", "authorizationReviewRef", "loadTestRef", "runbookRef", "restoreDrillRef", "dataReviewRef"],
          "properties": {
            "threatModelRef": { "$ref": "#/$defs/relativePath" },
            "authorizationReviewRef": { "$ref": "#/$defs/relativePath" },
            "loadTestRef": { "$ref": "#/$defs/relativePath" },
            "runbookRef": { "$ref": "#/$defs/relativePath" },
            "restoreDrillRef": { "$ref": "#/$defs/relativePath" },
            "dataReviewRef": { "$ref": "#/$defs/relativePath" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "level": { "const": "production" } } },
          "then": { "required": ["criticality", "slo", "recovery", "security", "dataGovernance", "consistency", "resilience", "evidence"] }
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "table", "description"],
      "properties": {
        "name": { "type": "string", "maxLength": 128, "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "table": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "description": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestPath", "externalBasePath", "permissionPrefix", "permissions"],
      "properties": {
        "requestPath": { "type": "string", "maxLength": 128, "pattern": "^[a-z][A-Za-z0-9]*$" },
        "externalBasePath": { "type": "string", "maxLength": 500, "pattern": "^/[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$" },
        "permissionPrefix": { "type": "string", "maxLength": 128, "pattern": "^[a-z][a-z0-9_:-]*$" },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page", "detail", "create", "update", "remove"],
          "properties": {
            "page": { "type": "string", "minLength": 1 },
            "detail": { "type": "string", "minLength": 1 },
            "create": { "type": "string", "minLength": 1 },
            "update": { "type": "string", "minLength": 1 },
            "remove": { "type": "string", "minLength": 1 },
            "export": { "type": "string", "minLength": 1, "description": "可选，声明后生成 GET /export 接口" }
          }
        }
      }
    },
    "database": { "enum": ["oracle", "mysql"] },
    "databaseTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "location"],
      "properties": {
        "schema": { "type": "string", "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_$#]*$" },
        "location": { "type": "string", "minLength": 1, "maxLength": 200 },
        "estimatedRows": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "estimatedBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "downtimeBudgetSeconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "onlineDdl": { "type": "boolean" },
        "backupRef": { "type": "string", "minLength": 1, "maxLength": 300 },
        "recoveryOwner": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "rollbackStrategy", "verificationSql"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]{8}_[0-9]{6}$" },
        "rollbackStrategy": { "type": "string", "minLength": 20 },
        "verificationSql": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 4000 } }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelJava": { "$ref": "#/$defs/relativePath" },
        "serviceJava": { "$ref": "#/$defs/relativePath" },
        "serviceResources": { "$ref": "#/$defs/relativePath" },
        "testJava": { "$ref": "#/$defs/relativePath" },
        "migration": { "$ref": "#/$defs/relativePath" },
        "rollback": { "$ref": "#/$defs/relativePath" },
        "collaboration": { "$ref": "#/$defs/relativePath" }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "column", "javaType", "dbType", "comment", "writable"],
        "properties": {
          "name": { "type": "string", "pattern": "^(?!is[A-Z0-9_])[a-z][A-Za-z0-9]*$" },
          "column": { "type": "string", "pattern": "^(?![iI][sS]_)[A-Za-z][A-Za-z0-9_]*$", "description": "Oracle 必须大写，MySQL 必须小写；禁止 is_ 前缀；运行时按方言强校验" },
          "javaType": { "enum": ["String", "Integer", "Long", "Boolean", "BigDecimal", "LocalDate", "LocalDateTime", "List<String>", "List<Long>"] },
          "dbType": { "type": "string", "pattern": "^[A-Z][A-Z0-9_(), ]*$" },
          "comment": { "type": "string", "minLength": 1, "maxLength": 100 },
          "requiredOnCreate": { "type": "boolean", "default": false },
          "nullable": { "type": "boolean", "description": "物理列可空性；与 API requiredOnCreate 分离" },
          "defaultValue": { "description": "物理默认值；仅在数据库设计文档明确给出时声明" },
          "requiredOnQuery": { "type": "boolean", "default": false, "description": "仅当查询接口契约明确要求时启用；不得由数据库 NOT NULL 推导" },
          "writable": { "type": "boolean", "default": false, "description": "必须显式声明；状态/审批等命令字段应为 false" },
          "queryMode": { "enum": ["none", "eq", "like"], "default": "none" },
          "detail": { "type": "boolean", "default": true },
          "list": { "type": "boolean", "default": true },
          "maxLength": { "type": "integer", "minimum": 1, "maximum": 4000, "deprecated": true, "description": "兼容旧契约；新契约只使用 constraints.maxLength" },
          "constraints": { "$ref": "#/$defs/constraints", "description": "新增/修改请求约束；未声明时只使用可确定的数据库存储边界" },
          "constraintSource": { "type": "string", "minLength": 1, "maxLength": 300 },
          "queryConstraints": { "$ref": "#/$defs/constraints", "description": "查询请求专用约束；禁止从数据库列长度或精度机械继承" },
          "queryConstraintSource": { "type": "string", "minLength": 1, "maxLength": 300 },
          "contextSource": { "enum": ["client", "server"], "default": "client", "description": "server 字段由认证/服务上下文产生，不得进入客户端请求 DTO" },
          "externalId": { "$ref": "#/$defs/stableId", "description": "可选，对应 design-model field.id" },
          "semanticId": { "$ref": "#/$defs/stableId", "description": "企业级数据语义/指标口径稳定 ID" },
          "definition": { "type": "string", "minLength": 1, "maxLength": 500 },
          "enumValues": { "type": "array", "minItems": 1, "uniqueItems": true, "items": {} },
          "initialValue": { "description": "不可由通用 DTO 写入的状态/治理字段初始值；生成 Java 赋值与数据库 DEFAULT NOT NULL" },
          "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
          "masking": { "enum": ["none", "partial", "full"], "description": "机密/受限字段必须显式声明的响应脱敏策略" },
          "logPolicy": { "enum": ["allow", "exclude"], "description": "confidential/restricted 强制 exclude" },
          "encryptionRequired": { "type": "boolean" },
          "retentionDays": { "type": "integer", "minimum": 1, "maximum": 36500 },
          "dataOwner": { "type": "string", "minLength": 1, "maxLength": 100 },
          "sourceOfTruth": { "type": "string", "minLength": 1, "maxLength": 100 }
        }
      }
    },
    "indexes": {
      "type": "array",
      "maxItems": 100,
      "description": "可选，自定义索引。COMPANY_ID+DELETE_FLAG 联合索引默认生成，无需重复声明。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "columns"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "minLength": 1, "maxLength": 64 },
          "columns": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" } },
          "unique": { "type": "boolean", "default": false }
        }
      }
    },
    "customOperations": {
      "type": "array",
      "maxItems": 100,
      "description": "可选，业务命令/状态机。请求字段必须被 patch.fromRequest 显式消费，写入使用租户+有效标记+版本原子 SQL。",
      "items": { "$ref": "#/$defs/customOperation" }
    },
    "businessKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "description": "业务去重契约；生成 create/update 的租户+有效数据校验和直观业务提示。数据库并发唯一性仍须由 databaseConstraintRef 指向已评审方案。",
      "items": { "$ref": "#/$defs/businessKey" }
    },
    "relations": {
      "type": "array",
      "maxItems": 100,
      "description": "可选，主从关联。当前只支持一对多；从表用独立 contract 描述。",
      "items": { "$ref": "#/$defs/relation" }
    },
    "validationRules": {
      "type": "array",
      "maxItems": 100,
      "description": "可选，显式跨字段请求校验；不得按字段名称猜测",
      "items": { "$ref": "#/$defs/validationRule" }
    },
    "logicalIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "description": "跨系统稳定逻辑 ID；算法、规范化、版本和输出长度必须显式固定。",
      "items": { "$ref": "#/$defs/logicalId" }
    },
    "integrations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "description": "跨系统集成契约；显式声明方向、参与方、载荷版本、身份、重试、确认、死信和重放闭环。",
      "items": { "$ref": "#/$defs/integration" }
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "httpStatus", "message", "owner", "retryable", "operations"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "httpStatus": { "type": "integer", "minimum": 400, "maximum": 599 },
          "message": { "type": "string", "minLength": 1, "maxLength": 200 },
          "owner": { "type": "string", "minLength": 1, "maxLength": 100 },
          "retryable": { "type": "boolean" },
          "operations": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } }
        }
      }
    },
    "alter": {
      "type": "object",
      "additionalProperties": false,
      "description": "可选，ALTER TABLE。声明后 migration 生成 ALTER SQL，不再生成 CREATE TABLE。",
      "required": ["version", "phase", "rollbackStrategy", "verificationSql", "operations"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]{8}_[0-9]{6}$" },
        "phase": { "enum": ["expand", "contract"], "description": "expand 只允许 add/modify；contract 只允许 drop" },
        "approvalRef": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{5,63}$", "description": "contract 阶段必填的 DBA/变更审批单" },
        "impactRef": { "type": "string", "minLength": 1, "maxLength": 300, "description": "未配置 Catalog 时必填：人工 impact field 结论/工单引用；配置 Catalog 后机器自动执行影响分析" },
        "rollbackStrategy": { "type": "string", "minLength": 20 },
        "verificationSql": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "operations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/alterOperation" } },
        "indexes": { "$ref": "#/$defs/indexes", "description": "ALTER 本版本新增的索引；禁止用顶层 indexes 重复创建存量索引" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["assurance"],
        "properties": { "assurance": { "required": ["level"], "properties": { "level": { "const": "production" } } } }
      },
      "then": {
        "required": ["dbCluster", "databaseTarget", "errors"],
        "properties": {
          "databaseTarget": { "required": ["schema", "location", "estimatedRows", "estimatedBytes", "downtimeBudgetSeconds", "onlineDdl", "backupRef", "recoveryOwner"] },
          "fields": { "items": { "required": ["semanticId"] } }
        }
      }
    }
  ],
  "$defs": {
    "stableId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{1,63}$" },
    "relativePath": { "type": "string", "maxLength": 500, "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "constraints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "minLength": { "type": "integer", "minimum": 0, "maximum": 4000 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 500 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "minExclusive": { "type": "boolean" },
        "maxExclusive": { "type": "boolean" },
        "totalDigits": { "type": "integer", "minimum": 1, "maximum": 65 },
        "fractionDigits": { "type": "integer", "minimum": 0, "maximum": 30 }
      }
    },
    "validationRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "startField", "endField", "operations", "message", "source"],
      "properties": {
        "kind": { "const": "chronology" },
        "startField": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "endField": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "allowEqual": { "type": "boolean", "default": true },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["create", "update", "page"] }
        },
        "message": { "type": "string", "minLength": 2, "maxLength": 100 },
        "source": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "logicalId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "field", "strategy", "sourceFields", "maxLength", "algorithmVersion", "canonicalization"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "field": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "strategy": { "enum": ["business-key", "uuid-v5", "sha256"] },
        "sourceFields": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "delimiter": { "type": "string", "minLength": 1, "maxLength": 1 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 256 },
        "algorithmVersion": { "type": "string", "pattern": "^v[1-9][0-9]*$", "maxLength": 20 },
        "namespace": { "type": "string", "format": "uuid" },
        "canonicalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["trim", "case", "nullToken", "charset"],
          "properties": {
            "trim": { "const": true },
            "case": { "enum": ["preserve", "upper", "lower"] },
            "nullToken": { "type": "string", "minLength": 1, "maxLength": 10 },
            "charset": { "const": "UTF-8" }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "strategy": { "const": "business-key" } } }, "then": { "required": ["delimiter"] } },
        { "if": { "properties": { "strategy": { "const": "uuid-v5" } } }, "then": { "required": ["namespace"], "properties": { "maxLength": { "const": 36 } } } },
        { "if": { "properties": { "strategy": { "const": "sha256" } } }, "then": { "properties": { "maxLength": { "const": 64 } } } }
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "direction", "producer", "consumer", "transport", "payloadVersion", "contractRef", "identityId", "retry", "acknowledgement", "deadLetter", "replay", "operations", "errorCodes"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "direction": { "enum": ["inbound", "outbound", "bidirectional"] },
        "producer": { "type": "string", "minLength": 1, "maxLength": 300 },
        "consumer": { "type": "string", "minLength": 1, "maxLength": 300 },
        "transport": { "type": "string", "minLength": 1, "maxLength": 300 },
        "payloadVersion": { "type": "string", "minLength": 1, "maxLength": 300 },
        "contractRef": { "type": "string", "minLength": 1, "maxLength": 300 },
        "identityId": { "$ref": "#/$defs/stableId" },
        "orderingKey": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts", "backoff", "initialDelayMs", "maxDelayMs"],
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 0, "maximum": 3 },
            "backoff": { "enum": ["fixed", "exponential"] },
            "initialDelayMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
            "maxDelayMs": { "type": "integer", "minimum": 0, "maximum": 86400000 }
          }
        },
        "acknowledgement": { "enum": ["none", "sync", "async"] },
        "deadLetter": { "type": "boolean" },
        "replay": { "type": "boolean" },
        "operations": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "errorCodes": { "type": "array", "minItems": 1, "maxItems": 200, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" } }
      },
      "allOf": [
        { "if": { "properties": { "direction": { "enum": ["outbound", "bidirectional"] } } }, "then": { "required": ["orderingKey"] } },
        { "if": { "properties": { "retry": { "properties": { "maxAttempts": { "minimum": 1 } } } } }, "then": { "properties": { "deadLetter": { "const": true } } } }
      ]
    },
    "customField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "javaType", "comment"],
      "properties": {
        "name": { "type": "string", "pattern": "^(?!is[A-Z0-9_])[a-z][A-Za-z0-9]*$" },
        "javaType": { "enum": ["String", "Integer", "Long", "Boolean", "BigDecimal", "LocalDate", "LocalDateTime"] },
        "comment": { "type": "string", "minLength": 1, "maxLength": 100 },
        "required": { "type": "boolean", "default": false },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "classification": { "enum": ["public", "internal", "confidential", "restricted"] },
        "masking": { "enum": ["none", "partial", "full"] },
        "logPolicy": { "enum": ["allow", "exclude"] }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value", "message"],
      "properties": {
        "field": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "operator": { "enum": ["equals", "notEquals", "in", "notIn", "isNull", "notNull"] },
        "value": {},
        "message": { "type": "string", "minLength": 5, "maxLength": 100 }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field"],
      "properties": {
        "field": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
        "value": {},
        "fromRequest": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" }
      },
      "oneOf": [
        { "required": ["value"], "not": { "required": ["fromRequest"] } },
        { "required": ["fromRequest"], "not": { "required": ["value"] } }
      ]
    },
    "customOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "method", "path", "permission", "kind"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "minLength": 2, "maxLength": 30 },
        "summary": { "type": "string", "minLength": 2, "maxLength": 50 },
        "method": { "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
        "path": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]*(?:/(?:[A-Za-z][A-Za-z0-9]*|\\{[a-z][A-Za-z0-9]*\\}))*$", "description": "相对 requestPath 的路径，如 submit/{id}" },
        "permission": { "type": "string", "pattern": "^[a-z][a-z0-9_:-]*$", "minLength": 1 },
        "kind": { "enum": ["stateTransition", "command", "batch"], "description": "stateTransition=状态机变更；command=业务命令；batch=批量操作（idFrom=body）" },
        "idFrom": { "enum": ["path", "body", "none"], "description": "默认 stateTransition/command=path（路径含 {id}），batch=body" },
        "requestFields": { "type": "array", "items": { "$ref": "#/$defs/customField" }, "description": "可选额外请求字段，如 approve 的 opinion" },
        "preconditions": { "type": "array", "items": { "$ref": "#/$defs/precondition" }, "description": "四段式②：校验前置状态" },
        "patch": { "type": "array", "items": { "$ref": "#/$defs/patch" }, "description": "四段式③：构造字段变更" },
        "batchPolicy": { "$ref": "#/$defs/batchPolicy", "description": "批量操作对已选记录的业务一致性与分组数量门禁；仅 kind=batch 可用" },
        "externalId": { "$ref": "#/$defs/stableId" }
      }
    },
    "businessKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fields", "operations", "normalization", "message", "source", "databaseConstraintRef"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "minLength": 2, "maxLength": 50 },
        "fields": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "scopeFields": { "type": "array", "minItems": 1, "maxItems": 10, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["create", "update"] } },
        "normalization": { "enum": ["exact", "trim"] },
        "message": { "type": "string", "minLength": 2, "maxLength": 100 },
        "source": { "type": "string", "minLength": 1, "maxLength": 300 },
        "databaseConstraintRef": { "type": "string", "minLength": 1, "maxLength": 300, "description": "数据库并发唯一性/软删重建策略的迁移、索引或评审引用" }
      }
    },
    "batchPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectionScope", "minItems", "sameFields", "distinct", "messages", "source"],
      "properties": {
        "selectionScope": { "const": "selected-only" },
        "minItems": { "type": "integer", "minimum": 2, "maximum": 1000 },
        "sameFields": { "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" } },
        "distinct": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "count"],
            "properties": {
              "field": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
              "count": { "type": "integer", "minimum": 1, "maximum": 1000 }
            }
          }
        },
        "messages": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minItems", "sameFields", "distinct"],
          "properties": {
            "minItems": { "type": "string", "minLength": 2, "maxLength": 100 },
            "sameFields": { "type": "string", "minLength": 2, "maxLength": 100 },
            "distinct": { "type": "string", "minLength": 2, "maxLength": 100 }
          }
        },
        "source": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "detailEntity", "detailContractId", "joinColumn"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$", "description": "关联属性名，如 items/details" },
        "type": { "enum": ["one-to-many"], "description": "当前仅支持一对多" },
        "detailEntity": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "detailContractId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,79}$" },
        "joinColumn": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "description": "从表外键列名；大小写按数据库方言" },
        "cascadeSoftDelete": { "type": "boolean", "default": false, "description": "主表软删时同步软删从表" },
        "exposeQuery": { "type": "boolean", "default": true, "description": "主 Controller 暴露 queryXxxByParentId 接口" },
        "externalId": { "$ref": "#/$defs/stableId" }
      }
    },
    "alterOperation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["add", "drop", "modify"] },
        "field": { "$ref": "#/$defs/alterField", "description": "add 时必填；expand 新增列必须允许 NULL" },
        "column": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "description": "drop/modify 时必填" },
        "fromDbType": { "type": "string", "pattern": "^[A-Z][A-Z0-9_(), ]*$", "description": "modify 时必填，用于评审变更前类型" },
        "dbType": { "type": "string", "pattern": "^[A-Z][A-Z0-9_(), ]*$", "description": "modify 时必填" },
        "comment": { "type": "string", "minLength": 1, "maxLength": 100, "description": "modify 时必填" },
        "compatibility": { "const": "widening", "description": "modify 只允许显式声明扩容" }
      }
    },
    "alterField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "column", "javaType", "dbType", "comment"],
      "properties": {
        "name": { "type": "string", "pattern": "^(?!is[A-Z0-9_])[a-z][A-Za-z0-9]*$" },
        "column": { "type": "string", "pattern": "^(?![iI][sS]_)[A-Za-z][A-Za-z0-9_]*$" },
        "javaType": { "enum": ["String", "Integer", "Long", "Boolean", "BigDecimal", "LocalDate", "LocalDateTime", "List<String>", "List<Long>"] },
        "dbType": { "type": "string", "pattern": "^[A-Z][A-Z0-9_(), ]*$" },
        "comment": { "type": "string", "minLength": 1, "maxLength": 100 },
        "requiredOnCreate": { "const": false },
        "nullable": { "const": true, "description": "expand 新列必须先允许 NULL" },
        "defaultValue": { "description": "设计文档明确给出时声明" },
        "queryMode": { "enum": ["none", "eq", "like"] },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 4000 }
      }
    },
    "indexes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "columns"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$", "minLength": 1, "maxLength": 64 },
          "columns": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" } },
          "unique": { "type": "boolean", "default": false }
        }
      }
    }
  }
}
