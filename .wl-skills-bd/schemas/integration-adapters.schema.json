{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-team.example/schemas/wl-integration-adapters-v1.json",
  "title": "Platform-owned messaging and integration adapter descriptors",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adapters", "bindings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "displayName", "contractTransports", "detector", "qualityGate"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "provider": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "contractTransports": { "$ref": "#/$defs/nonEmptyStrings" },
          "detector": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["groupId", "artifactId"],
                  "properties": {
                    "groupId": { "type": "string", "minLength": 1 },
                    "artifactId": { "type": "string", "minLength": 1 }
                  }
                }
              },
              "producerAnyOf": { "$ref": "#/$defs/strings" },
              "consumerAnyOf": { "$ref": "#/$defs/strings" },
              "configurationAnyOf": { "$ref": "#/$defs/strings" },
              "testAnyOf": { "$ref": "#/$defs/strings" },
              "runtimeEvidenceAnyOf": { "$ref": "#/$defs/strings" },
              "capabilityAnyOf": {
                "type": "object",
                "propertyNames": { "$ref": "#/$defs/id" },
                "additionalProperties": { "$ref": "#/$defs/nonEmptyStrings" }
              }
            }
          },
          "qualityGate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inbound", "outbound"],
            "properties": {
              "inbound": { "$ref": "#/$defs/directionPolicy" },
              "outbound": { "$ref": "#/$defs/directionPolicy" }
            }
          },
          "implementationRecipes": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "direction", "templateRef", "output"],
              "properties": {
                "id": { "$ref": "#/$defs/id" },
                "direction": { "$ref": "#/$defs/direction" },
                "templateRef": { "$ref": "#/$defs/relativePath" },
                "output": { "type": "string", "minLength": 1 },
                "requiredVariables": { "$ref": "#/$defs/strings" }
              }
            }
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "module", "adapterId", "direction", "contractRef", "integrationId"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "module": { "type": "string", "minLength": 1 },
          "adapterId": { "$ref": "#/$defs/id" },
          "direction": { "$ref": "#/$defs/direction" },
          "contractRef": { "$ref": "#/$defs/relativePath" },
          "integrationId": { "type": "string", "minLength": 1 },
          "sourceRefs": { "$ref": "#/$defs/paths" },
          "configRefs": { "$ref": "#/$defs/paths" },
          "testRefs": { "$ref": "#/$defs/paths" },
          "runtimeEvidenceRefs": { "$ref": "#/$defs/paths" },
          "requiredCapabilities": { "$ref": "#/$defs/strings" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "direction": { "enum": ["inbound", "outbound", "bidirectional"] },
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "nonEmptyStrings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
    "directionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredStages"],
      "properties": {
        "requiredStages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["declared", "dependency", "configured", "wired", "tested", "runtime-evidenced"] }
        },
        "requiredCapabilities": { "$ref": "#/$defs/strings" },
        "severity": { "enum": ["error", "warn", "info"] }
      }
    }
  }
}
