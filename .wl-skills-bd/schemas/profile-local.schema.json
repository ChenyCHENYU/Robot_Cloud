{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agile-team.example/schemas/wl-profile-local-v1.json",
  "title": "wl-skills-bd project-local profile override",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId"],
  "anyOf": [
    { "required": ["softDelete"] },
    { "required": ["auditTime"] },
    { "required": ["idPolicy"] },
    { "required": ["auditColumns"] }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "type": "string", "minLength": 1 },
    "softDelete": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "column": { "type": "string", "pattern": "^(?!IS_)[A-Z][A-Z0-9_]{0,62}$" },
        "javaField": { "const": "deleteFlag" },
        "activeValue": { "type": "integer" },
        "deletedValue": { "type": "integer" },
        "mysqlType": { "enum": ["TINYINT(1)", "INT"] },
        "oracleType": { "type": "string", "pattern": "^NUMBER\\([1-9]\\)$" }
      }
    },
    "auditTime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mysqlType": { "type": "string", "pattern": "^(VARCHAR\\(19\\)|DATETIME(\\([0-6]\\))?)$" },
        "oracleType": { "type": "string", "pattern": "^(VARCHAR2\\(19 CHAR\\)|TIMESTAMP(\\([0-9]\\))?)$" }
      }
    },
    "idPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "javaType": { "const": "String" },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "oracleType": { "type": "string", "pattern": "^VARCHAR2\\([1-9][0-9]{0,3} CHAR\\)$" },
        "mysqlType": { "type": "string", "pattern": "^VARCHAR\\([1-9][0-9]{0,3}\\)$" },
        "format": { "enum": ["opaque", "uuid", "numeric-string"] }
      }
    },
    "auditColumns": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actorMaxLength": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "createUserNullable": { "type": "boolean" },
        "updateUserNullable": { "type": "boolean" },
        "createTimeNullable": { "type": "boolean" },
        "updateTimeNullable": { "type": "boolean" }
      }
    }
  }
}
