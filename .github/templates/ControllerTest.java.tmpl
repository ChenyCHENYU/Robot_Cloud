@ExtendWith(MockitoExtension.class)
class {{Entity}}ControllerTest {

    private static final int SUCCESS_CODE = 2000;

    @Mock private {{Entity}}Service service;

    private MockMvc mockMvc;

    @BeforeEach
    void setUp() {
        {{Entity}}Controller controller = new {{Entity}}Controller();
        ReflectionTestUtils.setField(controller, "{{entity}}Service", service);
        mockMvc = MockMvcBuilders.standaloneSetup(controller).build();
    }

    @Test
    void shouldUsePlatformEnvelopeWhenDetailSucceeds() throws Exception {
        when(service.getById("1000000000000000001")).thenReturn(null);
        mockMvc.perform(get("/{{requestPath}}/{{detailOperationPath}}", "1000000000000000001"))
                .andExpect(jsonPath("$.code").value(SUCCESS_CODE));
    }

    @Test
    void shouldDeclarePermissionAndRouteForDetail() throws Exception {
        Method method = {{Entity}}Controller.class.getDeclaredMethod("getById", String.class);
        PreAuthorize permission = method.getAnnotation(PreAuthorize.class);
        assertEquals("@pms.hasPermission('{{detailPermission}}')", permission.value());
        Annotation route = null;
        for (Annotation annotation : method.getDeclaredAnnotations()) {
            if ("{{detailHttpAnnotation}}".equals(annotation.annotationType().getSimpleName())) {
                route = annotation;
            }
        }
        assertEquals("{{detailHttpAnnotation}}", route.annotationType().getSimpleName());
        String[] paths = (String[]) route.annotationType().getMethod("value").invoke(route);
        assertEquals("{{detailOperationPath}}", paths[0]);
    }
